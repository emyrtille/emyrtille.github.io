---
import { getCollection } from 'astro:content';
const expertiseOrder = ['backend-engineering', 'performance-reliability', 'architecture-system-evolution', 'developer-experience-automation', 'technical-collaboration-delivery'];
const expertiseEntries = await getCollection('expertise');
const expertise = expertiseOrder
  .map((id) => expertiseEntries.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof expertiseEntries)[number] => entry !== undefined);

const focusAreas = [
  { index: '01', title: 'Build', description: 'Designing and shipping software, one thoughtful decision at a time.' },
  { index: '02', title: 'Explore', description: 'Trying things out, asking questions, and finding a way through uncertainty.' },
  { index: '03', title: 'Simplify', description: 'Making APIs, tools, and everyday developer workflows a little easier.' },
  { index: '04', title: 'Care', description: 'Paying attention to reliability, performance, and the people using what we build.' },
];


---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111613" />
    <meta name="description" content="Emy — software engineer based near Lyon, France. Building thoughtful software, APIs, and better developer experiences." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>Emy — Software Engineer</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="Emy, home">emy<span class="brand-dot">.</span>dev</a>
        <nav aria-label="Main navigation">
          <a href="#expertise">Expertise</a>
          <a href="#about">About</a>
        </nav>
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> SOFTWARE ENGINEER <span class="eyebrow-separator">/</span> LYON, FRANCE</p>
            <h1 id="hero-title">Building software,<br /> <em>with care.</em></h1>
            <p class="hero-intro">Hi, I'm Emy. I like turning complex ideas into useful software — and making the journey a little smoother for the people building it.</p>
            <div class="hero-actions">
              <a class="button-primary" href="#expertise">Explore my expertise <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#about">A little about me <span aria-hidden="true">↗</span></a>
            </div>
          </div>


        </section>

        <section class="focus" aria-label="What I like working on">
          {focusAreas.map((area) => (
            <article class="focus-item">
              <span class="focus-index">{area.index} /</span>
              <h2>{area.title}</h2>
              <p>{area.description}</p>
            </article>
          ))}
        </section>

        <section class="expertise-section" id="expertise" aria-labelledby="expertise-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow accent">A CLOSER LOOK</p>
              <h2 id="expertise-title">Areas of <em>expertise.</em></h2>
            </div>
            <p>Five perspectives on my engineering work, from building backend services to helping teams deliver them.</p>
          </div>
          <div class="expertise-list">
            {expertise.map((entry, index) => (
              <a class="expertise-link" href={`/expertise/${entry.id}/`} aria-label={`Explore ${entry.data.title}`}>
                <span class="expertise-number">{String(index + 1).padStart(2, '0')} /</span>
                <span class="expertise-info">
                  <span class="expertise-name">{entry.data.title}</span>
                  <span class="expertise-description">{entry.data.description}</span>
                </span>
                <span class="expertise-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="about-section" id="about" aria-labelledby="about-title">
          <p class="eyebrow accent">A LITTLE ABOUT ME</p>
          <div class="about-layout">
            <h2 id="about-title">Curious by nature.<br /><em>Engineer by choice.</em></h2>
            <div class="about-copy">
              <p>I'm a software engineer based near Lyon, France. I enjoy working close to the code, exploring ideas through prototypes, and building software that is pleasant to use and maintain.</p>
              <p>My work spans APIs, integrations, developer experience, performance, and technical decisions made alongside product teams. I care about the details, but also about keeping things simple.</p>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <a class="brand" href="#top">emy<span class="brand-dot">.</span>dev</a>
        <span>Made with care.</span>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  :root{font-family:'DM Sans',sans-serif;color:#edece5;background:#111613;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
  *{box-sizing:border-box}
  body{margin:0}
  a{color:inherit;text-decoration:none}
  a:focus-visible{outline:2px solid #e99683;outline-offset:5px}
  ::selection{background:#dc917d;color:#101713}
  .site-shell{max-width:1500px;margin:auto;padding:0 clamp(22px,6vw,100px)}
  .site-header{min-height:105px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #303932}
  .brand{font-weight:700;letter-spacing:-.075em;font-size:1.6rem}.brand-dot{color:#e99583}
  nav{display:flex;align-items:center;gap:clamp(20px,3vw,50px);font-size:.82rem;color:#cdd5cb}
  nav a:hover,.site-footer a:hover,.text-link:hover{color:#ef9d89}
  .hero{min-height:570px;display:flex;align-items:center;position:relative}
  .hero-copy{position:relative;max-width:950px;padding:100px 0 110px}
  .eyebrow,.focus-index{font-family:'DM Mono',monospace;font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;color:#a1b2a4}
  .eyebrow{display:flex;align-items:center;gap:12px}.eyebrow-separator{opacity:.45}.status-dot{display:inline-block;width:7px;height:7px;background:#e88e7b;border-radius:50%}
  h1,h2,h3,p{margin-top:0}
  h1,h2{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-.025em}
  h1{font-size:clamp(4.5rem,7.4vw,8rem);line-height:.94;margin:34px 0 29px;white-space:nowrap}
  em{font-weight:400;color:#e89b86}
  .hero-intro{font-size:clamp(1rem,1.45vw,1.25rem);color:#bbc5bc;line-height:1.7;max-width:600px}
  .hero-actions{display:flex;gap:32px;align-items:center;flex-wrap:wrap;margin-top:34px}
  .button-primary{background:#e99a86;color:#17201a;border-radius:3px;padding:16px 21px;font-size:.83rem;font-weight:700;display:inline-flex;gap:22px;align-items:center;transition:background .2s,transform .2s}
  .button-primary:hover{background:#f4af9d;transform:translateY(-2px)}
  .text-link{font-size:.83rem;font-weight:600;border-bottom:1px solid #748579;padding-bottom:5px;display:inline-flex;gap:20px;align-items:center;transition:color .2s}
  .focus{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid #303932;padding:35px 0 37px;gap:23px}
  .focus-item{border-right:1px solid #303932;padding:0 23px 0 0}.focus-item:last-child{border:0}
  .focus-index{color:#e59483;font-size:.65rem}
  .focus-item h2{font-size:2rem;margin:13px 0 8px}.focus-item p{font-size:.79rem;line-height:1.65;color:#a9b8ac;max-width:240px;margin-bottom:0}
  .section-heading{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:42px}
  .accent{color:#e99a86}.section-heading h2,.about-section h2{font-size:clamp(3.7rem,5.8vw,6rem);line-height:1;margin:20px 0 0}
  .section-heading>p{color:#9caea0;font-size:.88rem;max-width:340px;line-height:1.7;margin-bottom:3px}
  .expertise-section{border-top:1px solid #303932;padding:100px 0 115px;scroll-margin-top:28px}
  .expertise-list{border-top:1px solid #303932}
  .expertise-link{display:grid;grid-template-columns:72px minmax(0,1fr) 40px;align-items:center;gap:22px;padding:26px 16px 28px 0;border-bottom:1px solid #303932;transition:background .2s,border-color .2s}
  .expertise-link:hover,.expertise-link:focus-visible{background:#19221c;border-color:#617e65}
  .expertise-number{font-family:'DM Mono',monospace;font-size:.7rem;letter-spacing:.1em;color:#e99a86;align-self:start;padding-top:7px}
  .expertise-info{display:flex;flex-direction:column;gap:8px;min-width:0}
  .expertise-name{font-family:'Instrument Serif',Georgia,serif;font-size:clamp(1.8rem,3vw,2.65rem);line-height:1.1}
  .expertise-description{font-size:.84rem;color:#aebbb0;line-height:1.6;max-width:690px}
  .expertise-arrow{font-size:1.35rem;color:#e99a86;justify-self:end;transition:transform .2s}
  .expertise-link:hover .expertise-arrow{transform:translate(3px,-3px)}
  .about-section{border-top:1px solid #303932;padding:90px 0 120px}
  .about-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:80px}
  .about-section h2{font-size:clamp(3.2rem,5vw,5.8rem);line-height:1.08}
  .about-copy{padding-top:20px;max-width:480px}
  .about-copy p{line-height:1.8;color:#b6c3b7;font-size:.97rem}.about-copy .text-link{margin-top:14px}
  .site-footer{border-top:1px solid #303932;display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:115px}.site-footer span{color:#879b8b;font-size:.75rem}.site-footer>a:last-child{font-size:.8rem}
  @media(max-width:1000px){.hero{min-height:520px}.hero-copy{padding:85px 0}h1{font-size:clamp(3.3rem,6vw,5.2rem);white-space:normal;overflow-wrap:normal}.focus{grid-template-columns:repeat(2,1fr);row-gap:30px}.focus-item:nth-child(2){border-right:0}.focus-item:nth-child(3),.focus-item:nth-child(4){padding-top:20px;border-top:1px solid #303932}}
  @media(max-width:690px){.site-header{min-height:76px}.brand{font-size:1.4rem}nav{gap:17px;font-size:.76rem}.hero{min-height:unset;display:block}.hero-copy{padding:82px 0 80px}.hero .eyebrow{font-size:.58rem;gap:8px}h1{font-size:clamp(3.75rem,12vw,6rem);white-space:normal;margin:26px 0}.hero-intro{max-width:410px}.hero-actions{gap:22px}.focus{padding:28px 0;gap:18px}.focus-item{padding-right:12px}.focus-item h2{font-size:1.75rem}.focus-item p{font-size:.76rem}.expertise-section{padding:70px 0 80px}.expertise-link{grid-template-columns:38px minmax(0,1fr) 22px;gap:10px;padding:22px 6px 24px 0}.expertise-name{font-size:1.85rem}.expertise-description{font-size:.78rem}.expertise-arrow{font-size:1.1rem}.section-heading{display:block;margin-bottom:27px}.section-heading>p{margin:20px 0 0}.about-section{padding:65px 0 75px}.about-layout{display:block}.about-copy{padding-top:28px}.site-footer{flex-wrap:wrap;padding:27px 0;min-height:unset}.site-footer span{width:auto}}
  @media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}.button-primary,.text-link,.expertise-link,.expertise-arrow{transition:none}.button-primary:hover,.expertise-link:hover .expertise-arrow{transform:none}}
</style>
