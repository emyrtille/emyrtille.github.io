---
interface Props {
  title: string;
  description: string;
  headline: string;
  headlineAccent: string;
  intro: string;
  company: string;
  topics: string[];
}
const { title, description, headline, headlineAccent, intro, company, topics } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111613" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>{title} — Emy</title>
  </head>
  <body>
    <div class="shell">
      <header class="header">
        <a class="brand" href="/" aria-label="Emy, home">emy<span>.</span>dev</a>
        <a class="back" href="/">← Back to home</a>
      </header>
      <main>
        <p class="eyebrow">EXPERTISE / SOFTWARE ENGINEERING</p>
        <h1>{headline}<br /><em>{headlineAccent}</em></h1>
        <p class="lead">{intro}</p>
        <div class="meta"><span>{company}</span><span>{topics.join(' · ')}</span></div>
        <div class="prose"><slot /></div>
      </main>
      <footer><a class="brand" href="/">emy<span>.</span>dev</a><span>Made with care.</span></footer>
    </div>
  </body>
</html>
<style>

  :global(:root){font-family:'DM Sans',sans-serif;color:#edece5;background:#111613;font-synthesis:none;-webkit-font-smoothing:antialiased}
  :global(*){box-sizing:border-box}
  :global(body){margin:0}
  :global(a){color:inherit;text-decoration:none}
  :global(a:focus-visible){outline:2px solid #e99683;outline-offset:5px}
  :global(::selection){background:#dc917d;color:#101713}
  .shell{max-width:1120px;margin:auto;padding:0 clamp(22px,6vw,90px)}
  .header{min-height:105px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #303932}
  .brand{font-size:1.6rem;font-weight:700;letter-spacing:-.075em}.brand span{color:#e99583}
  .back{font-size:.85rem;color:#b9c9bc}.back:hover{color:#e99583}
  main{padding:100px 0 110px}
  .eyebrow{font-family:'DM Mono',monospace;font-size:.7rem;letter-spacing:.13em;color:#e99a86}
  h1,h2,h3,p{margin-top:0}
  h1,h2,h3,.prose :global(h3),.prose :global(h4){font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-.025em}
  h1{font-size:clamp(3.8rem,8vw,7.3rem);line-height:.98;margin:28px 0 30px}
  em{color:#e89b86;font-weight:400}
  .lead{font-size:clamp(1.15rem,2vw,1.5rem);line-height:1.6;max-width:800px;color:#c5d0c5}
  .meta{display:flex;flex-wrap:wrap;gap:14px 34px;border-top:1px solid #303932;margin-top:55px;padding-top:20px;color:#94ab9a;font-family:'DM Mono',monospace;font-size:.7rem}
  section{padding:85px 0;border-bottom:1px solid #303932;max-width:900px}
  section h2{font-size:clamp(3rem,5.4vw,5rem);line-height:1.05;margin:20px 0 30px}
  section>p:not(.eyebrow),.contributions p{max-width:760px;font-size:1rem;line-height:1.85;color:#b7c6ba}
  .contributions{display:grid;gap:18px}
  .contributions article{padding:27px 30px;background:#19221c;border:1px solid #2a392e}
  .contributions h3{font-size:2rem;margin-bottom:10px}
  .contributions p{margin-bottom:0;font-size:.95rem}
  .closing{border:0;padding-bottom:0}
  footer{border-top:1px solid #303932;min-height:115px;display:flex;align-items:center;justify-content:space-between;gap:20px}
  footer>span{color:#879b8b;font-size:.75rem}
  @media(max-width:690px){.header{min-height:76px}main{padding:70px 0 75px}h1{font-size:clamp(3.5rem,12vw,5rem)}section{padding:65px 0}.contributions article{padding:23px}footer{flex-wrap:wrap;padding:25px 0;min-height:unset}}

  /* Markdown content follows the existing editorial styling. */
  .prose{margin-top:76px}
  .prose :global(h2){font-family:'DM Mono',monospace;font-size:.7rem;letter-spacing:.13em;color:#e99a86;font-weight:400;margin:0 0 20px}
  .prose :global(h3){font-size:clamp(3rem,5.4vw,5rem);line-height:1.05;margin:0 0 30px}
  .prose :global(h3 em){color:#e89b86}
  .prose :global(p){max-width:760px;font-size:1rem;line-height:1.85;color:#b7c6ba}
  .prose :global(h2:not(:first-child)){border-top:1px solid #303932;padding-top:85px;margin-top:85px}
  .prose :global(h4){font-size:2rem;margin:26px 0 10px;padding:27px 30px 0;background:#19221c;border:1px solid #2a392e;border-bottom:0}
  .prose :global(h4 + p){background:#19221c;border:1px solid #2a392e;border-top:0;padding:0 30px 27px;margin-top:-10px;max-width:none}
  @media(max-width:690px){.prose{margin-top:56px}.prose :global(h2:not(:first-child)){padding-top:65px;margin-top:65px}.prose :global(h4){padding:23px 23px 0}.prose :global(h4 + p){padding:0 23px 23px}}
</style>
